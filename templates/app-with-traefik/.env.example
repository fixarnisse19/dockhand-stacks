# Unikt, gemener/bindestreck — används som namn på Traefik-router och -service.
APP_NAME=minapp
APP_HOST=minapp.example.com
APP_IMAGE=nginxinc/nginx-unprivileged:alpine
# Porten appen lyssnar på INNE i containern.
APP_PORT=8080

PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TZ=Europe/Stockholm
