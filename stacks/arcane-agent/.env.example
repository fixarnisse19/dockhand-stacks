# Kopiera till .env på den REMOTE värd som ska anslutas till spectre-green.
# Token genereras i Arcane: Environments -> Add Environment -> Edge.
AGENT_TOKEN=
# Adressen till Arcane på spectre-green, sedd från den här värden.
MANAGER_API_URL=http://192.168.1.10:3552
EDGE_TRANSPORT=poll
ARCANE_IMAGE_TAG=latest
PUID=1000
PGID=1000
TZ=Europe/Stockholm
