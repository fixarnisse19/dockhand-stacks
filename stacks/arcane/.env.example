# ---------------------------------------------------------------------------
# Arcane på spectre-green
# Kopiera till .env bredvid compose.yaml:  cp .env.example .env
# scripts/install-arcane.sh gör det åt dig och fyller i ENCRYPTION_KEY.
# .env är gitignorerad — den ska aldrig checkas in.
# ---------------------------------------------------------------------------

# --- Adress -----------------------------------------------------------------
# Domänen Traefik ska svara på.
ARCANE_HOST=arcane.example.com
# Måste vara exakt samma URL som du surfar på (schema + host, ingen slutslash).
APP_URL=https://arcane.example.com

# --- Hemligheter ------------------------------------------------------------
# 32 bytes: openssl rand -hex 32
# Krypterar registry-lösenord, git-tokens och OIDC-secrets i databasen.
# Byt ALDRIG efter första start utan att först exportera dem.
ENCRYPTION_KEY=

# --- Sökvägar på NAS:en -----------------------------------------------------
# Kör `bash scripts/inspect-docker-layout.sh` på NAS:en för att se var
# Dockhand, Portainer och stackarna faktiskt ligger — den föreslår båda
# värdena nedan. `install-arcane.sh --autodetect` sätter dem åt dig.
#
# Arcanes egen katalog (databas, builds, backuper). Läggs bredvid de andra
# hanterarna, och AVSIKTLIGT utanför STACKS_DIR så att Arcane inte försöker
# deploya sig själv.
ARCANE_ROOT=/volume1/docker/arcane
# Projektroten. Varje underkatalog med en compose-fil blir ett projekt i Arcane.
# Peka den på Dockhands stacks-katalog om Arcane ska se samma stackar.
# Monteras på SAMMA sökväg inuti containern — ändra inte det utan att läsa
# kommentaren i compose.yaml först.
STACKS_DIR=/volume1/docker/stacks

# --- Ägarskap / tid ---------------------------------------------------------
# id -u / id -g för den användare som ska äga filerna i STACKS_DIR.
PUID=1000
PGID=1000
TZ=Europe/Stockholm

# --- Nätverk ----------------------------------------------------------------
# Traefiks docker-nätverk. Kör du Dokploys Traefik: dokploy-network.
PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# CIDR:er som får sätta X-Forwarded-For. Täcker Dockers standardnät + LAN.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Direktport (fallback när proxyn ligger nere) ---------------------------
ARCANE_PORT=3552
# 0.0.0.0 = alla interface. Sätt NAS:ens LAN-IP om den är internetexponerad,
# eller 127.0.0.1 för att bara nå den via proxy/SSH-tunnel.
ARCANE_BIND_ADDR=0.0.0.0

# --- Övrigt -----------------------------------------------------------------
# Pinna till en version (t.ex. v2.4.0) när du vill styra uppgraderingar själv.
ARCANE_IMAGE_TAG=latest
# Hur djupt projektroten skannas efter compose-filer.
PROJECT_SCAN_MAX_DEPTH=4
ARCANE_BACKUP_VOLUME_NAME=arcane-backups
LOG_LEVEL=info
